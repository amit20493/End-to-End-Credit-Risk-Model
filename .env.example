# Application
APP_NAME=credit-risk-api
APP_ENV=production
LOG_LEVEL=INFO
API_KEY=
MODEL_PATH=artifacts/model.joblib
DECISION_THRESHOLD=0.5

# Training
RAW_DATA_PATH=data/raw/data.csv
PROCESSED_DATA_PATH=data/processed/processed_data.csv
TARGET_DATA_PATH=data/processed/processed_data_with_target.csv
RANDOM_STATE=42
TEST_SIZE=0.2
QUICK_TRAIN=false

# Optional MLflow
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=Credit_Risk_Modeling
